  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "Access modifiers: the exact lowercase forms /*@private; and /*@protected; set procedure visibility.",
          "match": "(/\\*)(@(?:private|protected))(;)",
          "name": "comment.block.ssl",
          "captures": {
            "2": {
              "name": "storage.modifier.access.ssl"
            }
          }
        },
        {
          "name": "comment.block.ssl",
          "begin": "/\\*",
          "end": ";"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.ssl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#sql-in-string"
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.ssl",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#sql-in-string"
        }
      ]
    },
    "string-bracket": {
      "name": "string.quoted.other.bracket.ssl",
      "match": "(?<![:\\w\\)\\}\\]])\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\]"
    },
    "builtInFunctions": {
