      "begin": "(:PROCEDURE)(\\s+)(?![Cc][Oo][Nn][Ss][Tt][Rr][Uu][Cc][Tt][Oo][Rr]\\b)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "beginCaptures": {
