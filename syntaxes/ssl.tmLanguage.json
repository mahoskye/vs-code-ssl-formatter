GetDataSetWithSchemaFromSelect|GetDataSetXMLFromArray|GetDataSetXMLFromSelect|GetDecimalSep|GetDecimalSeparator|GetDefaultConnection|GetDirFromFtp|GetFileVersion|GetFromApplication|GetFromFtp|GetFromSession|GetGroupSeparator|GetInlineCode|GetInternal|GetInternalC|GetLastSQLError|GetLastSSLError|GetLogsFolder|GetNETDataSet|GetNoLock|GetPrinters|GetRdbmsDelimiter|GetRegion|GetRegionEx|GetSSLDataset|GetSetting|GetSettings|GetTables|GetTransactionsCount|GetUserData|GetWebFolder|HasProperty|HashData|Hour|HtmlDecode|HtmlEncode|IIf|IgnoreSqlErrors|InBatchProcess|InfoMes|Integer|IsDBConnected|IsDefined|IsGuid|IsHex|IsInTransaction|IsInvariantDate|IsNumeric|IsProductionModeOn|IsTable|IsTableFld|JDay|LCase|LDAPAuth|LDAPAuthEX|LDir|LFromHex|LHex2Dec|LIMSDate|LKill|LLower|LSearch|LSelect|LSelect1|LSelectC|LStr|LToHex|LTransform|LTrim|LWait|Left|Len|LimsAt|LimsExec|LimsGetDateFormat|LimsNETCast|LimsNETConnect|LimsNETTypeOf|LimsOleConnect|LimsRecordsAffected|LimsSetCounter|LimsSqlConnect|LimsSqlDisconnect|LimsString|LimsTime|LimsType|LimsTypeEx|LimsXOr|Lower|MakeDateInvariant|MakeDateLocal|MakeDirOnFtp|MakeNETObject|MatFunc|Max|MimeDecode|MimeEncode|Min|Minute|Month|MoveInFtp|NoOfDays|Nothing|Now|PrepareArrayForIn|PrmCount|RaiseError|Rand|Rat|ReadBytesBase64|ReadFromFtp|ReadText|RenameOnFtp|Replace|Replicate|RetrieveLong|ReturnLastSQLError|Right|Round|RoundPoint5|RunApp|RunDS|RunSQL|SQLExecute|SQLRemoveComments|Scient|SearchLDAPUser|Second|Seconds|SendFromOutbox|SendLimsEmail|SendOutlookReminder|SendToFtp|SendToOutbox|ServerEndOfDay|ServerStartOfDay|ServerTimeZone|SetByName|SetDecimalSeparator|SetDefaultConnection|SetGroupSeparator|SetInternal|SetInternalC|SetSqlTimeout|SetUserData|SetUserPassword|ShowSqlErrors|SigFig|SortArray|Sqrt|StdRound|Str|StrSrch|StrTran|StrZero|StringToDate|SubStr|SubmitToBatch|SubmitToBatchEx|TableFldLst|Time|ToJson|ToNumeric|ToScientific|ToXml|Today|Trim|UpdLong|Upper|UrlDecode|UrlEncode|UserTimeZone|UsrMes|Val|ValidateDate|ValidateNumeric|VerifySignature|WriteBytesBase64|WriteText|WriteToFtp|XmlDomToUdObject|XmlExportSql|Year|_AND|_NOT|_OR|_XOR)\\b"
        }
      ]
    },
    "builtInClassInstantiation": {
      "patterns": [
        {
          "match": "(?i)\\b(AzureStorage|BatchSupport|CDataColumn|CDataColumns|CDataField|CDataRow|CDataTable|Email|EnterpriseExporter|FtpsClient|HtmlConverter|PatcherSupport|PdfSupport|RegSetup|SDMS|SDMSDocUploader|SQLConnection|SSLBaseDictionary|SSLCodeProvider|SSLDataset|SSLError|SSLExpando|SSLIntDictionary|SSLRegex|SSLSQLError|SSLStringDictionary|Sequence|TablesImport|WebServices)\\b(?=\\s*\\{)",
          "name": "support.class.ssl"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.ssl",
      "match": "(?:\\:=|\\+=|-=|\\*=|/=|\\^=|%=|==|!=|<>|#|<=|>=|<<|>>|\\*\\*|\\+\\+|--|<|>|=|\\+|-|\\*|/|%|\\^|\\.AND\\.|\\.OR\\.|\\.NOT\\.|\\$|!)"
    },
    "number": {
      "name": "constant.numeric.ssl",
      "match": "\\b\\d+(?:\\.\\d+[eE][+-]?\\d+|\\.\\d+)?\\b"
    },
    "keywords-colon": {
      "name": "keyword.control.ssl",
      "match": ":(?:LABEL|BEGINCASE|BEGININLINECODE|CASE|CATCH|CLASS|DECLARE|DEFAULT|ELSE|ENDCASE|ENDIF|ENDINLINECODE|ENDPROC|ENDREGION|ENDTRY|ENDWHILE|ERROR|EXITCASE|EXITFOR|EXITWHILE|FINALLY|FOR|IF|INCLUDE|INHERIT|LOOP|NEXT|OTHERWISE|PARAMETERS|PROCEDURE|PUBLIC|REGION|RESUME|RETURN|STEP|TO|TRY|WHILE)\\b"
    },
    "label-declaration": {
      "comment": "Labels: joined :LABELName; and spaced :LABEL Name; (extra words, as in :LABEL Name Alias;, are part of the label).",
      "begin": "(:LABEL)(?:([A-Za-z_][A-Za-z0-9_]*)\\b|(?=\\s+[A-Za-z_]))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ssl"
        },
        "2": {
          "name": "entity.name.label.ssl"
        }
      },
      "end": "(?=[^\\sA-Za-z0-9_])",
      "patterns": [
        {
          "name": "entity.name.label.ssl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "identifier": {
      "name": "variable.other.ssl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "property-access": {
      "begin": "\\b((?:Me|Base|[A-Za-z_][A-Za-z0-9_]*)(?:\\s*\\[[^\\]]+\\])*(?:\\s*:\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\([^)]*\\)|\\s*:\\s*[A-Za-z_][A-Za-z0-9_]*|\\s*\\([^)]*\\))*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
      "beginCaptures": {
        "1": {
          "name": "variable.other.object.ssl"
        },
        "2": {
          "name": "punctuation.accessor.colon.ssl"
        },
        "3": {
          "name": "variable.other.property.ssl"
        }
      },
      "end": "(?=\\s|;|,|\\)|\\]|\\})"
    },
    "method-call": {
      "begin": "\\b((?:Me|Base|[A-Za-z_][A-Za-z0-9_]*)(?:\\s*\\[[^\\]]+\\])*(?:\\s*:\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\([^)]*\\)|\\s*:\\s*[A-Za-z_][A-Za-z0-9_]*|\\s*\\([^)]*\\))*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "variable.other.object.ssl"
        },
        "2": {
          "name": "punctuation.accessor.colon.ssl"
        },
        "3": {
          "name": "support.function.method.ssl"
        },
        "4": {
          "name": "punctuation.section.arguments.begin.ssl"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.ssl"
        }
      },
      "patterns": [
        {
          "include": "#expressions"
        }
      ]
    },
    "code-block": {
      "patterns": [
        {
          "comment": "A code block needs at least one bound variable: {|| ...} does not compile.",
          "begin": "(\\{)(\\|\\s*\\|)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.codeblock.begin.ssl"
            },
            "2": {
              "name": "invalid.illegal.ssl"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.codeblock.end.ssl"
            }
          },
          "patterns": [
            {
              "include": "#expressions"
            }
          ],
          "name": "meta.code-block.ssl"
        },
        {
          "comment": "Code block {|params| expression}: the parameter list ends at the second bar.",
          "begin": "(\\{)(\\|)([^|]*)(\\|)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.codeblock.begin.ssl"
            },
            "2": {
              "name": "punctuation.separator.parameters.ssl"
            },
            "3": {
              "patterns": [
                {
                  "name": "variable.parameter.ssl",
                  "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
              ]
            },
            "4": {
              "name": "punctuation.separator.parameters.ssl"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.codeblock.end.ssl"
            }
          },
          "patterns": [
            {
              "include": "#expressions"
            }
          ],
          "name": "meta.code-block.ssl"
        }
      ]
