# Ship only the bundled extension entry + LSP binaries + static assets.
# NOTE: .vscodeignore is a BLOCKLIST — anything not matched below ships in
# the vsix by default, so new repo-root files must be excluded here unless
# they belong in the package.

# Build artifacts
out/**
node_modules/**
*.vsix
*.tsbuildinfo
dist-vsix/**
dist/**/*.map

# Source files
src/**
tests/**
scripts/**
formatter-tests/**
snapshots/**
*.ts
tsconfig.json
tsconfig.tsnode.json

# Editor / VS Code
.vscode/**
.vscode-test/**
.editorconfig
.eslintrc.json

# Development docs
docs/**
dev/**
.claude/**
status_keywords.txt
vsc-extension-quickstart.md

# CI/CD + git + npm
.github/**
.git/**
.gitignore
.gitattributes
.npmignore

# Re-include LSP server binaries (must be shipped despite broad excludes above)
!server/**
