{
    "name": "vs-code-ssl-formatter",
    "type": "module",
    "displayName": "STARLIMS Scripting Language",
    "description": "Comprehensive language support for STARLIMS SSL: formatting, IntelliSense, diagnostics, and code quality tools",
    "version": "1.24.0",
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Linters"
    ],
    "publisher": "mahoskye",
    "repository": {
        "type": "git",
        "url": "https://github.com/mahoskye/vs-code-ssl-formatter.git"
    },
    "icon": "media/icon.png",
    "bugs": {
        "url": "https://github.com/mahoskye/vs-code-ssl-formatter/issues"
    },
    "homepage": "https://github.com/mahoskye/vs-code-ssl-formatter#readme",
    "activationEvents": [],
    "contributes": {
        "languages": [
            {
                "id": "ssl",
                "aliases": [
                    "STARLIMS Scripting Language",
                    "ssl"
                ],
                "extensions": [
                    ".ssl",
                    ".srvscr",
                    ".ds",
                    ".ssl.txt",
                    ".ds.txt"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ssl",
                "scopeName": "source.ssl",
                "path": "./syntaxes/ssl.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "STARLIMS Scripting Language (SSL)",
            "properties": {
                "ssl.globals": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "string"
                    },
                    "description": "Variable names that should always be treated as declared globals (Hungarian notation recommended)"
                },
                "ssl.format.indentStyle": {
                    "type": "string",
                    "enum": [
                        "tab",
                        "space"
                    ],
                    "default": "tab",
                    "description": "Character type for indentation"
                },
                "ssl.format.indentWidth": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Number of tabs or spaces per indent level"
                },
                "ssl.format.builtinFunctionCase": {
                    "type": "string",
                    "enum": [
                        "preserve",
                        "PascalCase"
                    ],
                    "default": "PascalCase",
                    "description": "Casing for built-in function names when formatting. PascalCase normalizes to canonical casing, preserve keeps user's choice."
                },
                "ssl.format.wrapLength": {
                    "type": "number",
                    "default": 90,
                    "minimum": 60,
                    "maximum": 200,
                    "description": "Maximum line length before wrapping"
                },
                "ssl.format.operatorSpacing": {
                    "type": "boolean",
                    "default": true,
                    "description": "Insert spaces around operators when formatting"
                },
                "ssl.format.commaSpacing": {
                    "type": "boolean",
                    "default": true,
                    "description": "Insert spaces after commas when formatting"
                },
                "ssl.format.semicolonEnforcement": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ensure statements end with semicolons when formatting"
                },
                "ssl.format.blankLinesBetweenProcs": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 5,
                    "description": "Number of blank lines to insert between procedures"
                },
                "ssl.editor.autoInsertBlockClosers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically insert the matching :END... keyword (e.g. :ENDIF, :ENDCASE) when pressing Enter on a block-opening line such as :IF, :WHILE, :FOR, :BEGINCASE, :TRY, :PROCEDURE, :CLASS, :REGION."
                },
                "ssl.format.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Format SSL documents with the language server when saving. Equivalent to editor.formatOnSave for SSL files."
                },
                "ssl.format.trimTrailingWhitespace": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remove trailing whitespace from all lines when formatting"
                },
                "ssl.format.maxConsecutiveBlankLines": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 5,
                    "description": "Collapse runs of more than this many consecutive blank lines when formatting (default 2, matching starlims-lsp). 0 disables the cap and preserves blank lines as written."
                },
                "ssl.format.sql.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Format inline SQL string literals passed to SQLExecute/RunSQL/LSearch when true"
                },
                "ssl.format.sql.keywordCase": {
                    "type": "string",
                    "enum": [
                        "preserve",
                        "upper",
                        "lower"
                    ],
                    "default": "upper",
                    "description": "Preferred casing for SQL keywords when SQL formatting is enabled"
                },
                "ssl.format.sql.identifierCase": {
                    "type": "string",
                    "enum": [
                        "preserve",
                        "lower",
                        "upper"
                    ],
                    "enumDescriptions": [
                        "Preserve - Keep the author's casing (safe on every dialect; default)",
                        "Lower - Community-guide look (safe on Oracle and case-insensitive MSSQL collations only)",
                        "Upper - Match the STARLIMS data dictionary"
                    ],
                    "default": "preserve",
                    "markdownDescription": "Casing applied to table/column/alias identifiers in reflowed SQL (LSP formatter). Force-folding can break queries on SQL Server case-sensitive collations, so `preserve` is the default. Double-quoted identifiers and ODBC `{…}` escape interiors are always preserved."
                },
                "ssl.format.sql.indentSpaces": {
                    "type": "number",
                    "default": 4,
                    "minimum": 0,
                    "maximum": 12,
                    "description": "Number of spaces to indent formatted SQL clauses (ignored when SQL formatting disabled)"
                },
                "ssl.format.sql.style": {
                    "type": "string",
                    "enum": [
                        "standard",
                        "canonicalCompact",
                        "expanded"
                    ],
                    "enumDescriptions": [
                        "Standard - Simple clause breaks, wraps long lines at ssl.format.wrapLength",
                        "Canonical Compact - Balanced formatting with indented AND/OR and smart wrapping (default, per official style guide)",
                        "Expanded - Maximum readability, each column/condition on own line"
                    ],
                    "default": "canonicalCompact",
                    "description": "SQL formatting style. 'canonicalCompact' follows the official STARLIMS Style Guide. A stored 'compact' (retired) is migrated to 'canonicalCompact'."
                },
                "ssl.naming.hungarianNotation.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Hungarian notation validation"
                },
                "ssl.naming.hungarianNotation.checkTypes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Warn when a variable's Hungarian prefix promises one type but its assigned expression produces another (diagnostic hungarian_type_mismatch), e.g. nCode := SubStr(sText, 1, 4). Independent of ssl.naming.hungarianNotation.enabled: this reports a name that contradicts its own prefix, and only ever inspects names that already carry one, so it stays quiet on code that does not use the convention."
                },
                "ssl.naming.hungarianNotation.prefixes": {
                    "type": "array",
                    "default": [
                        "s",
                        "n",
                        "b",
                        "d",
                        "a",
                        "o",
                        "fn",
                        "v"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "Hungarian notation prefixes allowed for variable names"
                },
                "ssl.diagnostics.rules": {
                    "type": "object",
                    "default": {},
                    "description": "Per-rule severity overrides for LSP-emitted diagnostics. Keys are stable rule slugs (e.g. parameters_first, prefer_exitcase, udobject_array_in_clause); values are 'off', 'info', 'warn', or 'error'. Rules set to 'off' are dropped on the client; other values remap the LSP-supplied severity. Forwarded to the LSP via initializationOptions for future server-side support.",
                    "additionalProperties": {
                        "type": "string",
                        "enum": [
                            "off",
                            "info",
                            "warn",
                            "error"
                        ]
                    },
                    "propertyNames": {
                        "enum": [
                            "arithmetic_type_mismatch",
                            "array_index_whole_number",
                            "assignment_in_condition",
                            "bare_logical_operator",
                            "base_outside_class",
                            "base_requires_inherit",
                            "base_standalone",
                            "begincase_requires_case",
                            "branch_literal_target",
                            "branch_target_label",
                            "builder_directive_case",
                            "builder_directive_outside_datasource",
                            "builtin_excess_arguments",
                            "c_style_comment_closer",
                            "catch_clause_form",
                            "catch_order_before_finally",
                            "class_instantiation_curly",
                            "class_member_order",
                            "class_name_collision",
                            "class_or_script",
                            "code_block_comparison",
                            "code_block_structure",
                            "comment_swallows_code",
                            "comment_termination",
                            "comment_text_after_terminator",
                            "complex_sql_placeholder",
                            "constructor_outside_class",
                            "constructor_return_value",
                            "createudobject_builtin_misuse",
                            "datasource_default_required",
                            "datasource_sql_question_placeholder",
                            "datasource_sql_semicolon",
                            "datasource_undeclared_placeholder",
                            "declare_initializer",
                            "default_after_parameters",
                            "default_on_declare_line",
                            "deprecated_keyword",
                            "direct_procedure_call",
                            "dollar_string_only",
                            "doproc_in_class",
                            "dot_property_access",
                            "empty_optional_param_array",
                            "empty_parameters",
                            "endclass_invalid",
                            "endfor_invalid",
                            "equals_empty_string",
                            "equals_vs_strict_equals",
                            "error_handler_structure",
                            "execfunction_class_target",
                            "execfunction_missing_quotes",
                            "exitcase_after_return",
                            "exitcase_last_in_branch",
                            "exitfor_in_finally",
                            "exitfor_outside_loop",
                            "exitwhile_in_finally",
                            "exitwhile_outside_loop",
                            "finally_empty",
                            "for_numeric_values",
                            "format_arg_not_array",
                            "global_assignment",
                            "hungarian_notation",
                            "hungarian_type_mismatch",
                            "identifier_too_long",
                            "include_early",
                            "include_in_procedure",
                            "include_quoted_target",
                            "increment_as_statement",
                            "inherit_position",
                            "inherit_qualified_name",
                            "inline_code_naming",
                            "inline_default_outside_datasource",
                            "internal_error",
                            "invalid_limstypeex_comparison",
                            "invalid_native_member",
                            "invalid_operator_sequence",
                            "invalid_sql_param",
                            "invariant_date_columns_quoted",
                            "keyword_uppercase",
                            "label_keyword_form",
                            "limit_public_vars",
                            "loop_in_finally",
                            "loop_outside_loop",
                            "max_block_depth",
                            "max_params_warning",
                            "me_outside_class",
                            "mismatched_block_end",
                            "mismatched_delimiter",
                            "missing_otherwise",
                            "mixed_error_handling_families",
                            "mixed_type_operator",
                            "named_sql_param_unsupported",
                            "negative_logic",
                            "nested_iif",
                            "nil_in_operations",
                            "nil_method_call",
                            "nil_not_empty_string",
                            "no_default_statements_in_datasource",
                            "non_logical_condition",
                            "not_preferred_operator",
                            "nullasblank_value",
                            "one_assignment_per_statement",
                            "one_class_per_file",
                            "parameters_first",
                            "parenthesize_mixed_logical",
                            "parenthesize_negated_comparison",
                            "prefer_exitcase",
                            "prefer_explicit_trim_concat",
                            "procedure_declaration_syntax",
                            "procedure_length_review",
                            "raiseerror_in_catch",
                            "redeclare_is_noop",
                            "region_end_mismatch",
                            "return_in_finally",
                            "runsql_non_dml",
                            "scientific_notation",
                            "script_size_review",
                            "single_catch",
                            "single_finally",
                            "spaced_skip_commas",
                            "sql_comma_join",
                            "sql_dialect_mix",
                            "sql_inconsistent_alias",
                            "sql_injection",
                            "sql_legacy_outer_join",
                            "sql_literal_splice",
                            "sql_select_star",
                            "sql_suspect_placeholder",
                            "step_spacing",
                            "step_zero_literal",
                            "stray_block_keyword",
                            "trailing_skip_commas",
                            "try_requires_handler",
                            "try_structure",
                            "udobject_array_in_clause",
                            "unclosed_block",
                            "unclosed_delimiter",
                            "undeclared_variable",
                            "unexpected_token",
                            "unicode_literal_prefix",
                            "unjustified_collate",
                            "unknown_keyword",
                            "unknown_token",
                            "unmatched_block_end",
                            "unmatched_delimiter",
                            "unqualified_field_assignment",
                            "unqualified_field_read",
                            "unterminated_string",
                            "unused_variable",
                            "visibility_annotation",
                            "visibility_annotation_usage",
                            "zero_based_array_index"
                        ],
                        "description": "Stable rule slug emitted by starlims-lsp. See diagnostic_codes.go."
                    }
                },
                "ssl.diagnostics.endpointPatterns": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "string"
                    },
                    "markdownDescription": "Case-insensitive path substrings that mark a script as an SSL endpoint. Endpoint scripts get `Request` and `Response` as pre-injected ambients (no `undeclared_variable`, hover and completion both surface them). A leading `/* … Endpoint: …;` docblock in the first ~30 lines also activates endpoint mode without configuration."
                },
                "ssl.diagnostics.unusedVariables": {
                    "type": "boolean",
                    "default": false,
                    "description": "Report declared variables that are never used (hint severity, code unused_variable). Off by default: usage counting is name-based and deliberately conservative."
                },
                "ssl.diagnostics.infoDiagnostics": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Enable the info severity tier: advisory style observations and idiom notes (18 rules, e.g. `sql_comma_join`, `c_style_comment_closer`, `negative_logic`) aimed at assistant/LLM consumers and teams that want the full picture. Off by default so the everyday surface stays errors/warnings/hints. A rule listed explicitly in `ssl.diagnostics.rules` always shows regardless of this gate."
                },
                "ssl.diagnostics.maxProcedureCodeLines": {
                    "type": "number",
                    "default": 80,
                    "minimum": 0,
                    "markdownDescription": "Flag a procedure or class method with more than this many code lines as a prompt to review its length (`procedure_length_review`, info tier). Blank and comment-only lines do not count. `0` disables. Shown only with `#ssl.diagnostics.infoDiagnostics#` on or an explicit `#ssl.diagnostics.rules#` entry."
                },
                "ssl.diagnostics.maxScriptCodeLines": {
                    "type": "number",
                    "default": 400,
                    "minimum": 0,
                    "markdownDescription": "Flag a server script with more than this many code lines as a prompt to review its size (`script_size_review`, info tier). Blank and comment-only lines do not count. `0` disables. Shown only with `#ssl.diagnostics.infoDiagnostics#` on or an explicit `#ssl.diagnostics.rules#` entry."
                },
                "ssl.diagnostics.maxScriptProcedures": {
                    "type": "number",
                    "default": 12,
                    "minimum": 0,
                    "markdownDescription": "Flag a server script with more than this many local procedures as a prompt to review its size (`script_size_review`, info tier). `0` disables. Shown only with `#ssl.diagnostics.infoDiagnostics#` on or an explicit `#ssl.diagnostics.rules#` entry."
                },
                "ssl.styleGuide.limitBlockDepth": {
                    "type": "number",
                    "default": 4,
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Maximum nesting level for control structures (0 = disabled)"
                },
                "ssl.intellisense.codeLens.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show CodeLens reference counts above procedures"
                },
                "ssl.intellisense.signatureHelp.autoTrigger": {
                    "type": "boolean",
                    "default": false,
                    "description": "Auto-open the signature help popup while typing inside a function call. When false (default), signature help is available on hover and explicit invocation (Ctrl+Shift+Space) only. Changes take effect after reloading the window."
                },
                "ssl.intellisense.inlayHints.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable inlay hints for parameter names"
                },
                "ssl.intellisense.inlayHints.minParameterCount": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Minimum number of parameters a function must have before inlay hints are shown"
                },
                "ssl.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication with the language server"
                }
            }
        },
        "commands": [
            {
                "command": "ssl.toggleComment",
                "title": "SSL: Toggle Comment",
                "category": "SSL"
            },
            {
                "command": "ssl.formatSql",
                "title": "SSL: Format SQL",
                "category": "SSL"
            },
            {
                "command": "ssl.formatSqlPickStyle",
                "title": "SSL: Format SQL (Pick Style)",
                "category": "SSL"
            },
            {
                "command": "ssl.toggleInlayHints",
                "title": "SSL: Toggle Inlay Hints",
                "category": "SSL"
            },
            {
                "command": "ssl.restartLanguageServer",
                "title": "SSL: Restart Language Server",
                "category": "SSL"
            }
        ],
        "keybindings": [
            {
                "command": "ssl.toggleComment",
                "key": "ctrl+/",
                "mac": "cmd+/",
                "when": "editorTextFocus && editorLangId == ssl"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "submenu": "ssl.formatSql",
                    "group": "1_modification@99",
                    "when": "editorLangId == ssl"
                }
            ],
            "ssl.formatSql": [
                {
                    "command": "ssl.formatSql",
                    "group": "1_format@1"
                },
                {
                    "command": "ssl.formatSqlPickStyle",
                    "group": "1_format@2"
                }
            ]
        },
        "submenus": [
            {
                "id": "ssl.formatSql",
                "label": "Format SQL"
            }
        ]
    },
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run check-types && npm run bundle -- --production",
        "bundle": "node scripts/build.mjs",
        "bundle:watch": "node scripts/build.mjs --watch",
        "check-types": "tsc -p ./ --noEmit",
        "compile": "tsc -p ./ && node -e \"require('fs').mkdirSync('out',{recursive:true});require('fs').writeFileSync('out/package.json',JSON.stringify({type:'commonjs'},null,2))\"",
        "generate:slugs": "node scripts/generate-diagnostic-slugs.mjs",
        "sync:grammar": "node scripts/sync-grammar.mjs",
        "check:grammar": "node scripts/sync-grammar.mjs --check",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "npm run test:unit",
        "test:unit": "cross-env TS_NODE_PROJECT=tsconfig.tsnode.json NODE_OPTIONS=--no-deprecation node --import ./tests/register-loaders.mjs --experimental-specifier-resolution=node ./node_modules/mocha/bin/mocha.js \"tests/*.test.ts\"",
        "pretest:integration": "npm run bundle",
        "test:integration": "node ./out/tests/runTest.js",
        "test:corpus": "bun scripts/corpus-test.ts",
        "test:corpus:update": "bun scripts/corpus-test.ts --update-baseline",
        "package": "vsce package",
        "smoke": "node scripts/smoke-vsix.mjs",
        "package:platforms": "node scripts/package-platforms.mjs",
        "fetch-lsp": "node scripts/fetch-lsp-release.mjs"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/chai": "^4.3.20",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.1",
        "@types/vscode": "^1.105.0",
        "@typescript-eslint/eslint-plugin": "^5.59.1",
        "@typescript-eslint/parser": "^5.59.1",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.2.1",
        "chai": "^4.5.0",
        "cross-env": "^10.1.0",
        "esbuild": "^0.28.0",
        "eslint": "^8.39.0",
        "glob": "^11.0.0",
        "mocha": "^10.8.2",
        "ts-node": "^10.9.2",
        "typescript": "~5.1.6",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
